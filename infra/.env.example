# MySQL
MYSQL_DATABASE=ai_interview
MYSQL_USER=ai_interview_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# RabbitMQ
RABBITMQ_DEFAULT_USER=ai_interview_rabbit
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASS
RABBITMQ_DEFAULT_VHOST=ai_interview

# MinIO
MINIO_ROOT_USER=ai_interview_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_INPUT=ai-interview-input
MINIO_BUCKET_OUTPUT=ai-interview-output
AI_INTERVIEW_MINIO_BUCKET=ai-interview-files

# Java Platform
AI_INTERVIEW_DB_URL=jdbc:mysql://mysql:3306/${MYSQL_DATABASE}
AI_INTERVIEW_DB_USERNAME=${MYSQL_USER}
AI_INTERVIEW_DB_PASSWORD=${MYSQL_PASSWORD}
AI_INTERVIEW_REDIS_HOST=redis
AI_INTERVIEW_REDIS_PASSWORD=${REDIS_PASSWORD}
AI_INTERVIEW_RABBITMQ_HOST=rabbitmq
AI_INTERVIEW_RABBITMQ_USERNAME=${RABBITMQ_DEFAULT_USER}
AI_INTERVIEW_RABBITMQ_PASSWORD=${RABBITMQ_DEFAULT_PASS}
AI_INTERVIEW_RABBITMQ_VHOST=${RABBITMQ_DEFAULT_VHOST}
AI_INTERVIEW_MINIO_ENDPOINT=http://minio:9000
AI_INTERVIEW_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
AI_INTERVIEW_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# Python Worker
AI_WORKER_ENV=docker
AI_WORKER_LOG_LEVEL=INFO
AI_WORKER_RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/${RABBITMQ_DEFAULT_VHOST}
AI_WORKER_RABBITMQ_VHOST=${RABBITMQ_DEFAULT_VHOST}
AI_WORKER_RABBITMQ_USERNAME=${RABBITMQ_DEFAULT_USER}
AI_WORKER_RABBITMQ_PASSWORD=${RABBITMQ_DEFAULT_PASS}
AI_WORKER_MINIO_ENDPOINT=http://minio:9000
AI_WORKER_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
AI_WORKER_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
AI_WORKER_MINIO_BUCKET=${AI_INTERVIEW_MINIO_BUCKET}
AI_WORKER_ENABLED_PROVIDERS=deepseek,dashscope
AI_WORKER_DEEPSEEK_API_KEY=
AI_WORKER_DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
AI_WORKER_SERPER_API_KEY=
